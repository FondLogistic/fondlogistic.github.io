<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FOND LOGISTIC</title>

<style>
body {
margin:0;
font-family:Arial;
background:linear-gradient(#1a0025,#000);
color:white;
text-align:center;
}

h1 {
font-size:42px;
color:#c084fc;
}

.card {
background:rgba(255,255,255,0.05);
margin:15px;
padding:20px;
border-radius:20px;
}

input, select {
width:80%;
padding:10px;
margin-top:10px;
border-radius:10px;
border:none;
}

button {
padding:12px;
border:none;
border-radius:10px;
margin-top:10px;
font-size:16px;
}

.whatsapp {background:#25D366;}
.telegram {background:#0088cc;}

.fixed {
position:fixed;
bottom:10px;
left:0;
right:0;
display:flex;
gap:10px;
padding:10px;
}

.fixed a {
flex:1;
text-decoration:none;
color:white;
padding:14px;
border-radius:12px;
}

</style>
</head>

<body>

<h1>FOND LOGISTIC</h1>
<p>Отгрузка на склады Wildberries</p>
<p>🔥 Осталось 3 слота на сегодня</p>

<div class="card">
<h3>💰 Рассчитать стоимость</h3>

<select id="city">
<option value="Электросталь 150">Электросталь / короб 150₽</option>
<option value="Коледино 1700">Коледино / паллет 1700₽</option>
<option value="СПБ 4000">СПБ / паллет 4000₽</option>
<option value="Казань 5000">Казань / паллет 5000₽</option>
<option value="Краснодар 5700">Краснодар / паллет 5700₽</option>
</select>

<select id="type">
<option value="150">Короб</option>
<option value="1700">Паллет</option>
</select>

<input type="number" id="qty" placeholder="Количество">

<button onclick="calc()">Рассчитать</button>

<p id="result"></p>

<button onclick="send()">Отправить заявку</button>

</div>

<div class="card">
<h3>🔥 Почему выбирают нас</h3>
<p>✔ Более 1000+ отгрузок</p>
<p>✔ Без срывов и задержек</p>
<p>✔ Быстрая запись</p>
</div>

<div class="card">
<h3>🎮 Мини игра</h3>
<canvas id="game" width="300" height="400"></canvas>
<p id="score"></p>
<button onclick="send()">Получить быструю отгрузку</button>
</div>

<div class="fixed">
<a href="#" onclick="send()" class="whatsapp">WhatsApp</a>
<a href="https://t.me/Fomin_No" class="telegram">Telegram</a>
</div>

<script>
let total=0;

function calc(){
let price=document.getElementById("type").value;
let qty=document.getElementById("qty").value;
total=price*qty;
document.getElementById("result").innerHTML="Итого: "+total+" ₽";
}

function send(){
let city=document.getElementById("city").value;
let qty=document.getElementById("qty").value;
let text="Здравствуйте, интересует отгрузка!%0AСклад: "+city+"%0AКол-во: "+qty;
window.location.href="https://wa.me/79772613079?text="+text;
}

// GAME
let canvas=document.getElementById("game");
let ctx=canvas.getContext("2d");

let car={x:130,y:300};
let obs=[];
let score=0;

document.addEventListener("keydown",e=>{
if(e.key=="ArrowLeft") car.x-=20;
if(e.key=="ArrowRight") car.x+=20;
});

function game(){
ctx.clearRect(0,0,300,400);

ctx.fillStyle="green";
ctx.fillRect(car.x,car.y,40,40);

if(Math.random()<0.03){
obs.push({x:Math.random()*260,y:0});
}

ctx.fillStyle="red";
for(let o of obs){
o.y+=5;
ctx.fillRect(o.x,o.y,30,30);

if(o.y>400){
score++;
document.getElementById("score").innerHTML="Очки: "+score;
}
}

requestAnimationFrame(game);
}

game();
</script>

</body>
</html>
